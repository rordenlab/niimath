{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "lib": ["ES2020", "DOM", "WebWorker"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "noEmit": false
  },
  "include": ["src/**/*"],
  "//": "Ship declarations for the library only. GPL wrappers (index-gpl/worker-gpl) are historical (BSD-only package); tests and build-only scripts must not emit .d.ts into dist/.",
  "exclude": ["node_modules", "dist", "src/**/*.js", "src/**/*.mjs", "src/index-gpl.ts", "src/worker-gpl.ts", "src/**/*.test.ts", "src/**/*.test.mts"]
}
